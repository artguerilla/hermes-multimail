#!/usr/bin/env bash
# Pre-commit hook for hermes-multimail
# Runs syntax check, lint, and tests before allowing commit.
set -euo pipefail

cd "$(dirname "$0")/.."

echo "Running pre-commit checks..."

# Syntax check
echo "  [1/3] Syntax check..."
python -m py_compile email_multi/*.py

# Lint
echo "  [2/3] Ruff lint..."
ruff check email_multi tests

# Tests
echo "  [3/3] Unit tests..."
python -m unittest

echo "All pre-commit checks passed."

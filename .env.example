# Email password environment variables
# Store your actual passwords in ~/.hermes/.env (chmod 600)
# Never commit plaintext passwords.

EMAIL_GMAIL_PASSWORD=your_app_password_here
EMAIL_COMPANY_PASSWORD=your_app_password_here

# Trusted caller identity for access control.
# Set this to the email address that should be authorized.
EMAIL_MULTI_CALLER=user@example.com

# Optional: trust params["caller"] from Hermes gateway tool calls.
# Only enable if your Hermes gateway injects a verified caller identity.
# Default: not set (params["caller"] is ignored)
# EMAIL_MULTI_TRUST_CALLER_PARAM=true

# Optional: override Hermes home directory
# HERMES_HOME=/path/to/custom-hermes-home

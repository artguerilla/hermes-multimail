# ── hermes-multimail: Environment Variables ─────────────
# Copy this file to ~/.hermes/.env and fill in your values.
# NEVER commit .env to version control (it is in .gitignore).

# IMAP/SMTP passwords — resolved via password_env in accounts.yaml
# Gmail: use App Passwords (Settings > Security > 2-Step Verification > App Passwords)
# Other providers: check your mail provider's app password documentation
EMAIL_GMAIL_PASSWORD=your_gmail_app_password_here
EMAIL_COMPANY_PASSWORD=your_company_password_here

# (Optional) Caller identity for access control
# When accounts have allowed_users lists, the caller identity is needed.
# Set this to the operator email that should have access to all accounts.
# EMAIL_MULTI_CALLER=operator@example.com

# (Optional) Override default Hermes home directory
# HERMES_HOME=~/.hermes

# (Optional) Inline JSON accounts config (alternative to accounts.yaml)
# EMAIL_MULTI_ACCOUNTS='[{"account_id":"gmail","email":"...","imap_host":"...","smtp_host":"...","password_env":"EMAIL_GMAIL_PASSWORD"}]'

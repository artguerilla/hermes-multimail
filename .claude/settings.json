{
  "permissions": {
    "allow": [
      "Read",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(python3 -m py_compile email_multi/*.py)",
      "Bash(python3 -m unittest*)",
      "Bash(python3 - <<'PY'*)",
      "Bash(bash -n *)"
    ],
    "ask": [
      "Edit",
      "Write",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(pip install *)",
      "Bash(python3 -m pip install *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Write(.env)",
      "Write(.env.*)",
      "Read(~/.hermes/*)",
      "Edit(~/.hermes/*)",
      "Write(~/.hermes/*)",
      "Bash(rm -rf *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git push origin dev*)",
      "Bash(git push origin main*)",
      "Bash(git push origin staging*)",
      "Bash(git push --force*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | bash*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git status --short --branch || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_TOOL_INPUT\" | grep -qE 'rm -rf|git reset --hard|git clean -fd|git push origin (dev|main|staging)|git push .*--force|curl .*\\| bash|wget .*\\| bash'; then echo 'Blocked by repo Claude policy'; exit 2; fi"
          }
        ]
      }
    ]
  }
}
